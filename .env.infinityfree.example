# ------------------------------------------------------------------
# Production settings for InfinityFree.
# Copy your local .env, change the values below, upload it to htdocs
# and name it ".env". Never commit the real file (it holds passwords).
# Keep your existing APP_KEY line exactly as it is.
# ------------------------------------------------------------------

APP_NAME="UniCare"
APP_ENV=production
APP_DEBUG=false
# Use http:// here until the SSL certificate is active, then switch to https://
APP_URL=https://unicare.infinityfreeapp.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_43446215_unicare
DB_USERNAME=if0_43446215
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync